[
 {
  "label": "lifecycle ack",
  "method": "PATCH",
  "path": "/api/issues/<issue_new>/lifecycle?state=acknowledged",
  "body": null,
  "expected": {
   "_status": 200,
   "body": {
    "id": "issue_new",
    "lifecycle_state": "acknowledged"
   }
  }
 },
 {
  "label": "lifecycle resolved",
  "method": "PATCH",
  "path": "/api/issues/<issue_new>/lifecycle?state=resolved",
  "body": null,
  "expected": {
   "_status": 200,
   "body": {
    "id": "issue_new",
    "lifecycle_state": "resolved"
   }
  }
 },
 {
  "label": "lifecycle bad state",
  "method": "PATCH",
  "path": "/api/issues/<issue_new>/lifecycle?state=bogus",
  "body": null,
  "expected": {
   "_status": 400,
   "body": {
    "detail": "state must be one of {'new', 'acknowledged', 'snoozed', 'resolved'}"
   }
  }
 },
 {
  "label": "lifecycle 404",
  "method": "PATCH",
  "path": "/api/issues/999999999/lifecycle?state=new",
  "body": null,
  "expected": {
   "_status": 404,
   "body": {
    "detail": "Issue not found"
   }
  }
 },
 {
  "label": "snooze 30",
  "method": "PATCH",
  "path": "/api/issues/<issue_other>/snooze",
  "body": {
   "days": 30
  },
  "expected": {
   "_status": 200,
   "body": {
    "snoozed_until": "<timestamp>",
    "days": 30
   }
  }
 },
 {
  "label": "snooze default",
  "method": "PATCH",
  "path": "/api/issues/<issue_other>/snooze",
  "body": {},
  "expected": {
   "_status": 200,
   "body": {
    "snoozed_until": "<timestamp>",
    "days": 7
   }
  }
 },
 {
  "label": "snooze bad days",
  "method": "PATCH",
  "path": "/api/issues/<issue_other>/snooze",
