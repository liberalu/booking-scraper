{
    "name": "book-scraper/php",
    "description": "PHP port of the book-scraper crawler (roach-php). Reads the live Postgres schema owned by Alembic.",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-pdo_pgsql": "*",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "league/html-to-markdown": "^5.1",
        "php-collective/toml": "^0.1.5",
        "psr/log": "^3.0",
        "symfony/css-selector": "^8.1",
        "symfony/dom-crawler": "^8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BookScraper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BookScraper\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
