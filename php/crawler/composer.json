{
  "name": "book-scraper/crawler",
  "description": "roach-php crawler. Separate from the dashboard because roach-php 3.x pins Guzzle ^7.8 and Laravel 13 ships Guzzle 8 — the two cannot share a composer project.",
  "type": "project",
  "require": {
    "php": "~8.3.0 || ~8.4.0",
    "book-scraper/php": "@dev",
    "roach-php/core": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "repositories": [
    { "type": "path", "url": "../", "options": { "symlink": true } }
  ],
  "autoload": {
    "psr-4": { "BookScraper\\Crawler\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "BookScraper\\Crawler\\Tests\\": "tests/" }
  },
  "config": { "sort-packages": true }
}
