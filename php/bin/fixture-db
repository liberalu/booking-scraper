#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Build the fixture-only database the frozen API shapes are taken over.
 *
 *   bin/fixture-db [--recreate] --database=postgresql://…/book_scraper_php_test
 *
 * The DSN names any database on the TEST cluster; the fixture database is a
 * sibling of it. Prints the fixture DSN on success.
 */

use BookScraper\Testing\FixtureDatabase;

require __DIR__ . '/../vendor/autoload.php';

$template = '';
$recreate = false;
foreach (array_slice($argv, 1) as $arg) {
    if (preg_match('/^--database=(.+)$/', $arg, $m) === 1) {
        $template = $m[1];
    } elseif ($arg === '--recreate') {
        $recreate = true;
    }
}
$template = $template ?: (getenv('DATABASE_URL') ?: '');

if ($template === '') {
    fwrite(STDERR, "fixture-db: pass --database=DSN or set DATABASE_URL\n");
    exit(1);
}

try {
    echo FixtureDatabase::ensure($template, $recreate) . "\n";
} catch (Throwable $e) {
    fwrite(STDERR, 'fixture-db: ' . $e->getMessage() . "\n");
    exit(1);
}
