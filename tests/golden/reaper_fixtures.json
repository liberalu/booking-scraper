{
  "_comment": [
    "Zombie-run shapes for the reaper characterisation. ONE definition, read by",
    "both planters: php/tools/reaper_diff.py (which compares the two stacks) and",
    "ReaperCharacterisationTest (which asserts the frozen outcome once Python is",
    "gone). Two copies would drift, and a drifted fixture makes the comparison",
    "assert nothing.",
    "heartbeat/claimed are Postgres interval strings, or null for 'never'.",
    "marker goes in close_reason, so first-writer-wins is itself asserted: the reaper must not overwrite a close_reason that is already set."
  ],
  "marker": "reaper-diff",
  "runs": [
    {
      "fixture": "silent_running",
      "phase": "scan",
      "status": "running",
      "heartbeat": "10 minutes"
    },
    {
      "fixture": "stuck_stopping",
      "phase": "scan",
      "status": "stopping",
      "heartbeat": "10 minutes"
    },
    {
      "fixture": "paused_alive",
      "phase": "discover_sitemap",
      "status": "paused",
      "heartbeat": "10 minutes"
    },
    {
      "fixture": "fresh_running",
      "phase": "scan",
      "status": "running",
      "heartbeat": "5 seconds"
    },
    {
      "fixture": "terminal_with_orphans",
      "phase": "scan",
      "status": "completed",
      "heartbeat": "10 minutes"
    },
    {
      "fixture": "no_heartbeat",
      "phase": "scan",
      "status": "running",
      "heartbeat": null
    },
    {
      "fixture": "paused_expired",
      "phase": "scan",
      "status": "paused",
      "heartbeat": "8 days"
    }
  ],
  "items": [
