# Installed inside the image, per-project, with --no-dev. Copying the host's
# vendor/ in would overwrite that with a tree that includes dev dependencies —
# and defeat the manifests-first layer caching.
**/vendor/

# Laravel's compiled package manifest. Built on the host it lists dev-only
# providers (Pail, Pint), and `package:discover` inside the image then fails
# with "Class Laravel\Pail\PailServiceProvider not found" because --no-dev
# never installed them. Regenerated by dump-autoload during the build.
bootstrap/cache/
storage/logs/
storage/framework/

# The container is configured by compose. A developer's .env points at
# localhost and has no business in an image.
**/.env

# Neither is needed at runtime, and both are large.
.git/
.venv/
_prototypes/
**/node_modules/
**/.phpunit.cache/
**/.phpunit.result.cache

# `COPY . .` takes the whole repository now that the application is the
# repository. None of these is needed at runtime.
docs/
monitoring/
.planning/
.claude/
.superpowers/
.github/
