#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Crawler\RunLifecycle;
use App\Repositories\CliRunRepository;
use App\Repositories\DatabaseRepositoryFactory;
use App\Repositories\ShopRepository;
use App\Services\MatchService;
use App\Support\Database;

require __DIR__.'/../vendor/autoload.php';

$opts = [];
foreach (array_slice($argv, 1) as $arg) {
    if (preg_match('/^--([a-z-]+)(?:=(.*))?$/', $arg, $m) === 1) {
        $opts[$m[1]] = $m[2] ?? '1';
    }
}

if (isset($opts['help'])) {
    fwrite(STDOUT, <<<'TXT'
    Usage: bin/match --shop=vaga [options]

      --synthesis      also run step 3 (synthesise canonical books from shop
                       data). Off by default: it invents `books` rows, so it
                       is opt-in on both stacks.
      --run-id=N       attribute to an existing run instead of opening one
      --database=DSN   override DATABASE_URL

    TXT);
    exit(0);
}

$shopName = $opts['shop'] ?? 'vaga';

Database::boot($opts['database'] ?? null);
$repositoryFactory = new DatabaseRepositoryFactory;
$shop = (new ShopRepository)->byName($shopName);

$lifecycle = null;
$runId = isset($opts['run-id']) ? (int) $opts['run-id'] : null;
if ($runId === null) {
    $lifecycle = new RunLifecycle($shop->id, 'match');
    $runId = $lifecycle->start()->id;
}

$synthesis = isset($opts['synthesis']) ? true : null;
printf("match %s (run %d)%s\n", $shopName, $runId, $synthesis ? ' with synthesis' : '');

try {
    $counters = (new MatchService($repositoryFactory->matching()))
        ->run($shopName, $synthesis);
} catch (Throwable $e) {
    $lifecycle?->fail($e);
    fwrite(STDERR, 'error: '.$e->getMessage()."\n");
    exit(1);
}

foreach ($counters as $key => $count) {
    printf("  %-20s %6d\n", $key, $count);
}

(new CliRunRepository)->setItemsUpdated($runId, $counters['books_linked']);
$lifecycle?->progress(
    processed: $counters['books_linked'],
    added: $counters['books_synthesized'],
    updated: $counters['books_linked'],
    errors: 0,
);
$lifecycle?->finish('completed');

printf(
    "done — %d linked, %d author link(s), %d synthesised\n",
    $counters['books_linked'],
    $counters['authors_linked'],
    $counters['books_synthesized'],
);
