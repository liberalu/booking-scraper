#!/usr/bin/env php
<?php

declare(strict_types=1);














use App\Support\Config;
use App\Support\CrawlSpawner;
use App\Crawler\CrawlerContext;
use App\Crawler\PostPhase;
use App\Discovery\GraphQlUrls;
use App\Discovery\IbibliotekaApiUrls;
use App\Discovery\LupaSearchUrls;
use App\Runs\ProgressReporter;
use App\Crawler\Persister;
use App\Crawler\RoachContainer;
use App\Crawler\RunLifecycle;
use App\Crawler\DiscoverSpider;
use App\Crawler\ScanSpider;
use App\Crawler\SerialScanner;
use App\Crawler\SerialCategoryDiscoverer;
use App\Crawler\Watchdog;
use App\Runs\ResumePolicy;
use App\Runs\RunReconciler;
use App\Runs\RunFailsafe;
use App\Repositories\CrawlerQueueRepository;
use App\Repositories\DatabaseRepositoryFactory;
use App\Repositories\PostPhaseRepository;
use App\Repositories\ShopRepository;
use App\Services\MatchService;
use App\Support\Database;
use App\Parsers\Vaga\Parser;
use RoachPHP\Roach;
use RoachPHP\Spider\Configuration\Overrides;
















ini_set('memory_limit', getenv('CRAWL_MEMORY_LIMIT') ?: '512M');

require __DIR__ . '/../vendor/autoload.php';

$crawler = new CrawlerContext;


function options(array $argv): array
{
    $opts = [];
    foreach (array_slice($argv, 2) as $arg) {
        if (preg_match('/^--([a-z-]+)(?:=(.*))?$/', $arg, $m) === 1) {
            $opts[$m[1]] = $m[2] ?? '1';
        }
    }

    return $opts;
}

function fail(string $message): never
{
    fwrite(STDERR, "error: {$message}\n");
    exit(1);
}

function flattenBatches(iterable $batches): Generator
{
    foreach ($batches as $batch) {
        foreach ($batch as $url) {
            yield $url;
        }
    }
}

















function installTerminationHandler(int $runId, callable $onStop, RunFailsafe $failsafe): void
{
    if (!function_exists('pcntl_signal')) {
        return;
    }
    $handler = static function () use ($runId, $onStop, $failsafe): void {
        fwrite(STDERR, "\n  received stop signal — finalising run {$runId}\n");
        $onStop();
        $failsafe->finalize($runId, 'failed', 'stopped', true);
        exit(1);
    };
    pcntl_signal(SIGTERM, $handler);
    pcntl_signal(SIGINT, $handler);
    pcntl_async_signals(true);
}










function recordDiscoverCloseIssues(
    CrawlerContext $crawler,
    string $shopName,
    string $baseUrl,
    string $strategy,
    int $urlsYielded,
    int $urlsBefore,
): void {
    $filtered = $crawler->filteredCount();
    if ($filtered > 0) {
        $crawler->issues()->add(
            'url_pattern_filtered',
            'url',
            '',
            "{$filtered} URLs excluded by pattern"
        );
    }
    if ($urlsYielded === 0 && $urlsBefore > 0) {
        $crawler->issues()->add(
            'discover_zero_yield',
            'run',
            $baseUrl,
            "phase=discover_{$strategy}, shop had {$urlsBefore} URLs pre-run"
        );
    }
}

function startWatchdog(
    CrawlerContext $crawler,
    int $runId,
    string $shop,
    string $phase,
    float $stallTimeout,
    RunFailsafe $failsafe,
): Watchdog
{
    $watchdog = new Watchdog(
        runId: $runId,
        shop: $shop,
        phase: $phase,
        stallTimeout: $stallTimeout,
        heartbeatInterval: (float) (getenv('HEARTBEAT_INTERVAL_S') ?: 5),
        maxResumeAttempts: (int) (getenv('STALL_AUTO_RESUME_MAX') ?: 10),
        dsn: App\Support\Database::bootedDsn(),
        failsafe: $failsafe,
    );
    $crawler->bindWatchdog($watchdog);
    installTerminationHandler($runId, static fn () => $watchdog->stop(), $failsafe);
    if ($watchdog->start()) {
        printf("watchdog: heartbeat %.0fs, stall timeout %.0fs\n",
            (float) (getenv('HEARTBEAT_INTERVAL_S') ?: 5), $stallTimeout);
    }

    return $watchdog;
}

$command = ($argv[1] ?? '') === '' || str_starts_with($argv[1], '--') ? '' : $argv[1];
$opts = options($command === '' ? array_merge([$argv[0], ''], array_slice($argv, 1)) : $argv);

if ($command === '' || isset($opts['help'])) {
    fwrite(STDOUT, <<<TXT
    Usage: bin/crawl <discover|scan|reconcile> [options]

      discover
        --strategy=S     sitemap (default), categories, graphql, lupasearch,
                         ibiblioteka_api or full_crawl
        --max-pages=N    cap category pages (dev runs)
        --max-bands=N    ibiblioteka_api only: cap how many monthly bands
                         open. Without it a run covers every month in the
                         configured year range (444 for 1990-2027).

      scan
        --max-urls=N     cap the number of URLs (default 20, 0 = uncapped)
        --mode=M         delta (default: skip URLs already scraped as
                         products) or full (re-scrape everything)
        --cron-job-id=N  internal: this run was fired by a cron job. Decides
                         which follow-up phase runs when it closes.
        --urls=A,B       scan these URLs instead of the pending queue
        --urls-file=PATH scan URLs from a private newline-delimited manifest
        --dry-run        fetch and parse, persist nothing
        --resumed-attempt=N
                         internal: adopt a resumable run's queue. Set by the
                         watchdog when it restarts a stalled crawl.
        --adopt-run-id=N internal: adopt this exact run's pending queue. Set
                         by the dashboard Continue/Retry actions.

      reconcile
        fail every run still marked `running` (call on boot — such a row
        belongs to a process the restart killed) and flag it resumable

      --database=DSN     override DATABASE_URL

    Shops: vaga, pegasas, patogupirkti, humanitas, almalittera, ibiblioteka.

    TXT);

    exit(isset($opts['help']) ? 0 : 1);
}

if ($command === 'reconcile') {


    Database::boot($opts['database'] ?? null);
    $orphans = (new RunReconciler)->markOrphansFailed();
    if ($orphans === []) {
        fwrite(STDOUT, "no orphaned runs\n");
        exit(0);
    }
    foreach ($orphans as $orphan) {
        printf(
            "orphaned run %d (%s/%s) -> failed, resumable\n",
            $orphan['id'],
            $orphan['shop'],
            $orphan['phase']
        );
    }
    printf("%d orphan(s) reconciled\n", count($orphans));
    exit(0);
}

if (!in_array($command, ['scan', 'discover'], true)) {
    fail("unknown command '{$command}' (expected 'discover', 'scan' or 'reconcile')");
}

$shopName = $opts['shop'] ?? 'vaga';
if (!App\Support\ParserRegistry::has($shopName)) {
    fail(sprintf(
        "no parser for shop '%s' — known shops: %s",
        $shopName,
        implode(', ', App\Support\ParserRegistry::shops())
    ));
}

$dryRun = isset($opts['dry-run']);



$maxUrls = (int) ($opts['max-urls'] ?? 20);
$maxUrls = $maxUrls <= 0 ? PHP_INT_MAX : $maxUrls;
$scanMode = $opts['mode'] ?? 'delta';


$cronJobId = isset($opts['cron-job-id']) ? (int) $opts['cron-job-id'] : null;
if (!in_array($scanMode, ['delta', 'full'], true)) {
    fail("mode '{$scanMode}' is not valid (delta|full)");
}

Database::boot($opts['database'] ?? null);
$repositoryFactory = new DatabaseRepositoryFactory;
$shops = new ShopRepository;
$queue = new CrawlerQueueRepository;
$failsafe = new RunFailsafe;
$progress = new ProgressReporter;
$postPhase = new PostPhase(
    new PostPhaseRepository,
    new MatchService($repositoryFactory->matching()),
    $failsafe,
    new CrawlSpawner,
);
$config = Config::forShop($shopName);


$config->applyShopSettings($shopName);
$shop = $shops->byName($shopName);



$stallTimeout = max(
    (float) (getenv('STALL_TIMEOUT') ?: 180),
    $config->requestTimeout() * 2
);



if ($command === 'discover') {
    $strategy = $opts['strategy'] ?? 'sitemap';
    $known = ['sitemap', 'categories', 'graphql', 'lupasearch', 'ibiblioteka_api', 'full_crawl'];
    if (!in_array($strategy, $known, true)) {
        fail("strategy '{$strategy}' is not ported (" . implode('|', $known) . ')');
    }
    if (!$config->hasStrategy($strategy)) {
        fail("shop '{$shopName}' has no [discover.{$strategy}] block");
    }

    $strategyConf = $config->strategy($strategy);
    $maxPages = (int) ($opts['max-pages'] ?? $strategyConf['max_pages'] ?? 0);



    $seedUrls = [];
    $template = '';
    $startUrl = '';
    if ($strategy === 'graphql') {
        $seedUrls = [GraphQlUrls::buildPageUrl(
            $config->baseUrl(),
            array_map('strval', (array) ($strategyConf['category_ids'] ?? [])),
            max(1, (int) ($strategyConf['page_size'] ?? 50)),
            1,
        )];
    } elseif ($strategy === 'lupasearch') {
        $endpoint = (string) ($strategyConf['endpoint'] ?? '');
        if ($endpoint === '') {
            fail('[discover.lupasearch] has no endpoint');
        }
        $seedUrls = [LupaSearchUrls::buildSeedUrl(
            $endpoint,
            array_map('strval', (array) ($strategyConf['category_ids'] ?? [])),
            max(1, (int) ($strategyConf['page_size'] ?? 42)),
            (array) ($strategyConf['extra_filters'] ?? []),
        )];
    } elseif ($strategy === 'ibiblioteka_api') {
        $seedUrls = IbibliotekaApiUrls::buildSeedUrls(
            (int) ($strategyConf['year_from'] ?? 1990),
            (int) ($strategyConf['year_to'] ?? 2027),
            max(10, (int) ($strategyConf['page_size'] ?? 100)),
        );





        $maxBands = (int) ($opts['max-bands'] ?? 0);
        if ($maxBands > 0) {
            $seedUrls = array_slice($seedUrls, 0, $maxBands);
        }
    } elseif ($strategy === 'full_crawl') {
        $startUrl = (string) ($strategyConf['start_url'] ?? '');
        if ($startUrl === '') {
            fail('[discover.full_crawl] has no start_url');
        }
        if ($maxPages === 0) {
            fwrite(STDERR, "  warning: full_crawl with no --max-pages will walk the"
                . " whole site; pass --max-pages=N to cap it\n");
        }
    } else {
        $templates = $config->strategyUrls($strategy);
        if (count($templates) === 1) {
            $template = $templates[0];
            $startUrl = str_replace('{page}', '1', $template);
        } else {
            $seedUrls = array_map(
                static fn (string $url): string => str_replace('{page}', '1', $url),
                $templates,
            );
        }
    }

    printf(
        "discover %s/%s — concurrency %d, delay %.2fs%s\n",
        $shopName,
        $strategy,
        $config->concurrency(),
        $config->downloadDelay(),
        $maxPages > 0 ? " (max {$maxPages} pages)" : ''
    );

    $lifecycle = new RunLifecycle($shop->id, "discover_{$strategy}");
    $run = $lifecycle->start();
    printf("scrape_runs id=%d\n", $run->id);

    $crawler->bind(
        new Persister(
            attributeSchema: $config->attributes(),
            issues: $crawler->issues(),
        ),
        $shop->id,
        $run->id,
        progress: $progress,
    );


    $progress->bind($run->id, static fn (array $t): int => $t['urls']);
    $urlsBefore = $queue->discoveredUrlCount($shop->id);



    $stableUrls = [];
    if ($strategy === 'full_crawl') {
        $stableUrls = array_fill_keys(
            $queue->stableUrls($shop->id),
            true
        );
        printf("full_crawl: %d URL(s) already classified recently\n", count($stableUrls));
    }
    $watchdog = startWatchdog(
        $crawler,
        $run->id,
        $shopName,
        'discover',
        $stallTimeout,
        $failsafe,
    );

    Roach::useContainer(new RoachContainer(
        requestDelaySeconds: $config->downloadDelay(),
        requestTimeout: $config->requestTimeout(),
        connectTimeout: $config->connectTimeout(),
        userAgent: 'Scrapy',
        runId: $run->id,
        crawler: $crawler,
    ));

    try {
        if ($strategy === 'categories' && $config->flaresolverr() !== null) {
            printf("flaresolverr: serial category discovery\n");
            $tally = (new SerialCategoryDiscoverer($shopName, $config, $crawler))
                ->run($config->strategyUrls($strategy), $maxPages);
        } else {
            Roach::startSpider(
                DiscoverSpider::class,
                new Overrides(concurrency: $config->concurrency()),
                [
                    'shop' => $shopName,
                    'strategy' => $strategy,
                    'run_id' => $run->id,
                    'start_url' => $startUrl,
                    'seed_urls' => $seedUrls,
                    'url_template' => $template,
                    'base_url' => $config->baseUrl(),
                    'page_size' => (int) ($strategyConf['page_size'] ?? 100),
                    'max_pages' => $maxPages,
                    'url_include_pattern' => $config->urlIncludePattern(),
                    'stable_urls' => $stableUrls,
                    'category_ids' => array_map('strval', (array) ($strategyConf['category_ids'] ?? [])),
                    'subdivide_factor' => (int) ($strategyConf['subdivide_factor'] ?? 5),
                    'subdivide_min_page_size' => (int) ($strategyConf['subdivide_min_page_size'] ?? 1),
                ],
            );
            $tally = $crawler->tally();
        }
        $lifecycle->progress(
            processed: $tally['urls'],
            added: $tally['added'],
            updated: $tally['updated'],
            errors: $tally['failed'],
        );
        $lifecycle->finish('completed');

        $watchdog->stop();
        printf(
            "done — %d url(s), books added %d, updated %d, failed %d\n",
            $tally['urls'],
            $tally['added'],
            $tally['updated'],
            $tally['failed'],
        );
        recordDiscoverCloseIssues(
            $crawler,
            $shopName,
            $config->baseUrl(),
            $strategy,
            $tally['urls'],
            $urlsBefore,
        );
        $written = $crawler->issues()->flush($shop->id, $run->id);
        if ($written > 0) {
            printf("validation: %d issue(s) recorded\n", $written);
        }
        $postPhase->after('discover', $shopName, $run->id, $cronJobId);
        exit(0);
    } catch (Throwable $e) {
        $watchdog->stop();


        $lifecycle->fail($e);
        $crawler->issues()->flush($shop->id, $run->id);
        $postPhase->chainSkipped($run->id, $cronJobId, substr($e->getMessage(), 0, 200));
        fail('run failed: ' . $e->getMessage());
    }
}



$resumedAttempt = isset($opts['resumed-attempt']) ? (int) $opts['resumed-attempt'] : 0;
$adoptRunId = isset($opts['adopt-run-id']) ? (int) $opts['adopt-run-id'] : null;
if ($dryRun && ($resumedAttempt > 0 || $adoptRunId !== null)) {
    fail('a resumed run cannot be combined with --dry-run');
}

$resumable = null;
$resumePolicy = new ResumePolicy(0);
if ($adoptRunId !== null) {
    $resumable = $resumePolicy->findResumableById($adoptRunId, $shop->id, 'scan');
    if ($resumable === null) {
        fail("run {$adoptRunId} is not an adoptable scan for shop '{$shopName}'");
    }
} elseif ($resumedAttempt > 0) {
    $resumable = $resumePolicy->findResumable($shop->id, 'scan');
    if ($resumable === null) {
        fail("no resumable scan queue exists for shop '{$shopName}'");
    }
}

$lifecycle = null;
$run = null;
if ($resumable !== null) {
    $lifecycle = RunLifecycle::adopt((int) $resumable->id);
    $run = $lifecycle->run()
        ?? throw new RuntimeException('adopted lifecycle has no run');
    $urlCount = $queue->pendingRunUrlCount($run->id, $maxUrls);
    $urlBatches = $queue->pendingRunUrlBatches($run->id, $maxUrls);
    printf(
        "resuming scrape_runs id=%d%s\n",
        $run->id,
        $resumedAttempt > 0 ? " (attempt {$resumedAttempt})" : ''
    );
} elseif (isset($opts['urls-file'])) {
    $manifest = $opts['urls-file'];
    if (! is_string($manifest) || ! is_file($manifest) || ! is_readable($manifest)) {
        fail('the URL manifest is not readable');
    }
    $contents = file_get_contents($manifest);
    @unlink($manifest);
    if ($contents === false) {
        fail('the URL manifest could not be read');
    }
    $urls = array_slice(
        array_values(array_filter(array_map('trim', preg_split('/\R/', $contents) ?: []))),
        0,
        $maxUrls,
    );
    foreach ($urls as $url) {
        \App\Support\CrawlerUrlPolicy::assertAllowed($url, $config->baseUrl());
    }
    $urlCount = count($urls);
    $urlBatches = [$urls];
} elseif (isset($opts['urls'])) {
    $urls = array_slice(
        array_values(array_filter(array_map('trim', explode(',', $opts['urls'])))),
        0,
        $maxUrls,
    );
    foreach ($urls as $url) {
        \App\Support\CrawlerUrlPolicy::assertAllowed($url, $config->baseUrl());
    }
    $urlCount = count($urls);
    $urlBatches = [$urls];
} else {
    $urlCount = $queue->scanUrlCount($shop->id, $scanMode, $maxUrls);
    $urlBatches = $queue->scanUrlBatches($shop->id, $scanMode, $maxUrls);
}

if ($urlCount === 0) {
    $lifecycle?->finish('completed', 'queue_empty');
    fwrite(STDOUT, "nothing to scan\n");
    exit(0);
}

printf(
    "scan %s — %d url(s), concurrency %d, delay %.2fs%s\n",
    $shopName,
    $urlCount,
    $config->concurrency(),
    $config->downloadDelay(),
    $dryRun ? ' [DRY RUN — nothing will be written]' : ''
);



if ($dryRun) {
    foreach (flattenBatches($urlBatches) as $url) {
        $body = @file_get_contents($url, false, stream_context_create([
            'http' => ['header' => "User-Agent: Scrapy\r\n", 'timeout' => $config->requestTimeout()],
        ]));
        if ($body === false) {
            printf("  FETCH FAIL  %s\n", $url);
            continue;
        }
        $parsed = Parser::parseProductPage($body);
        printf(
            "  %-58s %-9s %-14s %s\n",
            substr($url, 0, 58),
            $parsed['price'] ?? '—',
            $parsed['isbn'] ?? '—',
            substr((string) ($parsed['title'] ?? '(no title)'), 0, 40)
        );
        usleep((int) ($config->downloadDelay() * 1_000_000));
    }
    exit(0);
}






if ($lifecycle === null) {
    $lifecycle = new RunLifecycle($shop->id, 'scan');
    $run = $lifecycle->start($urlCount);
    printf("scrape_runs id=%d\n", $run->id);
}

$watchdog = startWatchdog(
    $crawler,
    $run->id,
    $shopName,
    'scan',
    $stallTimeout,
    $failsafe,
);



if ($config->flaresolverr() !== null) {
    printf("flaresolverr: serial fetch (session cannot be shared concurrently)\n");
    $progress->bind(
        $run->id,
        static fn (array $t): int => $t['added'] + $t['updated'] + $t['non_product']
            + ($t['canonical'] ?? 0),
    );
    $crawler->issues()->reset();
    try {
        $tally = (new SerialScanner(
            $shopName,
            $config,
            new Persister(
                attributeSchema: $config->attributes(),
                issues: $crawler->issues(),
            ),
            $shop->id,
            $run->id,
            $watchdog,
            progress: $progress,
        ))->run(flattenBatches($urlBatches));

        $lifecycle->progress(
            processed: $tally['added'] + $tally['updated'] + $tally['non_product']
                + ($tally['canonical'] ?? 0),
            added: $tally['added'],
            updated: $tally['updated'],
            errors: $tally['failed'],
        );
        $lifecycle->finish('completed');
        $watchdog->stop();

        printf(
            "done — added %d, updated %d, canonical %d, non-product %d, failed %d\n",
            $tally['added'],
            $tally['updated'],
            $tally['canonical'] ?? 0,
            $tally['non_product'],
            $tally['failed']
        );
        $written = $crawler->issues()->flush($shop->id, $run->id);
        if ($written > 0) {
            printf("validation: %d issue(s) recorded\n", $written);
        }
        $postPhase->after('scan', $shopName, $run->id, $cronJobId);
        exit(0);
    } catch (Throwable $e) {
        $watchdog->stop();
        $lifecycle->fail($e);
        $crawler->issues()->flush($shop->id, $run->id);
        $postPhase->chainSkipped($run->id, $cronJobId, substr($e->getMessage(), 0, 200));
        fail('run failed: ' . $e->getMessage());
    }
}

$crawler->bind(
    new Persister(
        attributeSchema: $config->attributes(),
        issues: $crawler->issues(),
    ),
    $shop->id,
    $run->id,
    progress: $progress,
);
$progress->bind(
    $run->id,
    static fn (array $t): int => $t['added'] + $t['updated'] + ($t['canonical'] ?? 0),
);
Roach::useContainer(new RoachContainer(
    requestDelaySeconds: $config->downloadDelay(),
    requestTimeout: $config->requestTimeout(),
    connectTimeout: $config->connectTimeout(),


    userAgent: 'Scrapy',
    runId: $run->id,
    crawler: $crawler,
));

try {
    foreach ($urlBatches as $urlBatch) {
        Roach::startSpider(
            ScanSpider::class,
            new Overrides(concurrency: $config->concurrency()),
            ['shop' => $shopName, 'urls' => $urlBatch],
        );
    }

    $tally = $crawler->tally();
    $lifecycle->progress(
        processed: $tally['added'] + $tally['updated'] + ($tally['canonical'] ?? 0),
        added: $tally['added'],
        updated: $tally['updated'],
        errors: $tally['failed'],
    );
    $lifecycle->finish('completed');
    $watchdog->stop();

    printf(
        "done — added %d, updated %d, canonical %d, non-product %d, failed %d\n",
        $tally['added'],
        $tally['updated'],
        $tally['canonical'] ?? 0,
        $tally['non_product'],
        $tally['failed']
    );
    $written = $crawler->issues()->flush($shop->id, $run->id);
    if ($written > 0) {
        printf("validation: %d issue(s) recorded\n", $written);
    }
    $postPhase->after('scan', $shopName, $run->id, $cronJobId);
} catch (Throwable $e) {
    $watchdog->stop();
    $lifecycle->fail($e);
    $crawler->issues()->flush($shop->id, $run->id);
    $postPhase->chainSkipped($run->id, $cronJobId, substr($e->getMessage(), 0, 200));
    fail('run failed: ' . $e->getMessage());
}
