#!/usr/bin/env php
<?php

declare(strict_types=1);











use App\Crawler\IssueBuffer;
use App\Crawler\ItemValidator;

require __DIR__ . '/../vendor/autoload.php';

$input = json_decode((string) file_get_contents('php://stdin'), true);
if (!is_array($input) || !isset($input['item'])) {
    fwrite(STDERR, "error: expected {\"url\": ..., \"item\": {...}} on stdin\n");
    exit(1);
}

$issues = new IssueBuffer;

['item' => $item, 'reject' => $reject] = ItemValidator::apply(
    $input['item'],
    (string) ($input['url'] ?? ''),
    $input['attributes'] ?? null,
    $issues,
);

echo json_encode([
    'item' => $item,
    'reject' => $reject,
    'issues' => $issues->drain(),
], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT), "\n";
