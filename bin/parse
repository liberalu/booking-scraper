#!/usr/bin/env php
<?php

declare(strict_types=1);













use App\Support\Config;
use App\Parsers\Vaga\Parser;
use GuzzleHttp\Client;
use GuzzleHttp\Exception\GuzzleException;

require __DIR__ . '/../vendor/autoload.php';

const FIXTURES = __DIR__ . '/../tests/fixtures';


function parseArgv(array $argv): array
{
    $opts = [];
    foreach (array_slice($argv, 1) as $arg) {
        if (preg_match('/^--([a-z-]+)(?:=(.*))?$/', $arg, $m) === 1) {
            $opts[$m[1]] = $m[2] ?? '1';
        }
    }

    return $opts;
}

function fail(string $message): never
{
    fwrite(STDERR, "error: {$message}\n");
    exit(1);
}

$opts = parseArgv($argv);

if (isset($opts['help'])) {
    fwrite(STDOUT, <<<TXT
    Usage: bin/parse [--url=URL | --file=PATH] [--kind=product|category|sitemap] [--shop=vaga]

      no args    parse the bundled product fixture (offline)
      --url      fetch one page live, paced by the shop's config
      --file      parse a local file
      --kind      what to parse as; inferred from the URL/file when omitted

    TXT);
    exit(0);
}

$shop = $opts['shop'] ?? 'vaga';
if ($shop !== 'vaga') {
    fail("only vaga is ported so far (got '{$shop}')");
}
$config = Config::forShop($shop);



$source = null;
if (isset($opts['url'])) {
    $url = $opts['url'];



    $client = new Client([
        'timeout' => $config->requestTimeout(),
        'connect_timeout' => $config->connectTimeout(),
        'headers' => ['User-Agent' => $opts['ua'] ?? 'Scrapy'],
        'http_errors' => false,
    ]);

    fwrite(STDERR, sprintf(
        "GET %s (timeout %.0fs, delay %.2fs)\n",
        $url,
        $config->requestTimeout(),
        $config->downloadDelay()
    ));



    usleep((int) ($config->downloadDelay() * 1_000_000));

    try {
        $response = $client->get($url);
    } catch (GuzzleException $e) {
        fail('request failed: ' . $e->getMessage());
    }

    $status = $response->getStatusCode();
    fwrite(STDERR, "HTTP {$status}\n");
    if ($status >= 400) {
        fail("shop returned HTTP {$status}");
    }

    $source = (string) $response->getBody();
    $kind = $opts['kind'] ?? (str_contains($url, 'sitemap') ? 'sitemap' : 'product');
} elseif (isset($opts['file'])) {
    $path = $opts['file'];
    if (!is_file($path)) {
        fail("no such file: {$path}");
    }
    $source = (string) file_get_contents($path);
    $kind = $opts['kind'] ?? (str_ends_with($path, '.xml') ? 'sitemap' : 'product');
} else {
    $source = (string) file_get_contents(FIXTURES . '/vaga_product_page.html');
    $kind = $opts['kind'] ?? 'product';
    fwrite(STDERR, "no --url/--file given; parsing bundled fixture\n");
}



$result = match ($kind) {
    'product' => Parser::parseProductPage($source),
    'category' => Parser::parseCategoryPage($source),
    'sitemap' => Parser::parseSitemapUrls($source),
    default => fail("unknown --kind '{$kind}' (product|category|sitemap)"),
};

fwrite(STDOUT, json_encode(
    $result,
    JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
) . "\n");
