{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "book-scraper/app",
    "type": "project",
    "description": "Book-scraper: the Laravel application. Holds the domain library, the roach-php crawler and the dashboard API in one project.",
    "license": "MIT",
    "require": {
        "ext-dom": "*",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "league/html-to-markdown": "^5.1",
        "php": "~8.3.0 || ~8.4.0",
        "php-collective/toml": "^0.1.5",
        "psr/log": "^3.0",
        "roach-php/core": "^3.0",
        "symfony/css-selector": "^7.4 || ^8.1",
        "symfony/dom-crawler": "^7.4 || ^8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5.12",
        "rector/rector": "^2.6",
        "slevomat/coding-standard": "^8.31",
        "spaze/phpstan-disallowed-calls": "^4.0",
        "symplify/easy-coding-standard": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "analyse": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "cs:fix": "@php vendor/bin/ecs check --fix",
        "cs:check": "@php vendor/bin/ecs check",
        "refactor": "@php vendor/bin/rector process",
        "refactor:check": "@php vendor/bin/rector process --dry-run",
        "lint": [
            "@format:check",
            "@cs:check",
            "@analyse",
            "@refactor:check"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
