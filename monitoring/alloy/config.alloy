

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["service"]
    regex         = "^$"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "book-scraper"
    action        = "keep"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.containers.receiver]
  labels     = {}
}

loki.process "containers" {
  stage.label_drop {
    values = ["service_name"]
  }
  stage.regex {
    expression = "(?P<level>DEBUG|INFO|WARNING|WARN|ERROR|CRITICAL|FATAL)\\b"
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.default.receiver]
}


local.file_match "spawn_files" {
  path_targets = [{
    __path__ = "/var/log/scrapy_runs/spawn-*.log",
    service  = "scraper",
    job      = "scrapy_spawn_files",
  }]
}

loki.source.file "spawn_files" {
  targets    = local.file_match.spawn_files.targets
  forward_to = [loki.process.spawn_labels.receiver]
}

loki.process "spawn_labels" {
  stage.label_drop {
    values = ["service_name"]
  }
  stage.regex {
    source     = "filename"
    expression = "/spawn-\\d{8}-\\d{12}-(?P<role>[a-z0-9_-]+)-(?P<shop>[a-z0-9_]+)\\.log$"
  }
  stage.labels {
    values = { role = "", shop = "" }
  }
  stage.regex {
    expression = "(?P<level>DEBUG|INFO|WARNING|WARN|ERROR|CRITICAL|FATAL)\\b"
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.default.receiver]
}



loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
